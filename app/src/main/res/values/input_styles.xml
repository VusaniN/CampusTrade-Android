<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">#071329</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AuthInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/field_text</item>
        <item name="android:textColorHint">@color/hint_text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
