rules_version = '2';
// CampusTrade Firestore rules (D4).
//
// Deploy after testing:
//   firebase deploy --only firestore:rules
//
// Security model:
//  - Only signed-in, verified @vossie.net accounts are treated as students.
//  - users/{uid} is private (owner + admin). publicProfiles/{uid} is the
//    signed-in directory used for names, email -> uid lookup and course/year.
//  - Orders must reference a real, available listing owned by the seller.
//  - Order status changes follow the same approval workflow as the app.
//  - Ratings require a COMPLETED order and one review per student per order.
//  - Private study groups are readable only by their owner and members.
//  - Chats use deterministic document ids and must match a real listing/seller
//    (or the explicit "direct" conversation marker).
// Always test changes in the Firebase Rules Playground / emulator before
// publishing them to the shared project.

service cloud.firestore {
  match /databases/{db}/documents {

    // A Firebase account with a campus email. This is intentionally separate
    // from signedIn(): registration must be able to create the profile before
    // the student clicks the verification link.
    function campusAccount() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@vossie[.]net');
    }

    // Every normal read/write requires a verified campus account.
    function signedIn() {
      return campusAccount() && request.auth.token.email_verified == true;
    }

    function isAccountOwner(userId) {
      return campusAccount() && request.auth.uid == userId;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // isAdmin is set in the Firebase console, never by the client.
    function isAdmin() {
      // The reserved moderator account always has admin rights. Other
      // moderators are promoted explicitly in users/{uid}.
      return signedIn()
        && (
          request.auth.token.email.lower() == 'eduv4941658@vossie.net'
          || (exists(/databases/$(db)/documents/users/$(request.auth.uid))
              && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.isAdmin == true)
        );
    }

    function isShortText(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function chatDocId(buyer, seller, listing) {
      return buyer + '_' + seller + '_' + listing;
    }

    // ---- private student profile -------------------------------------------
    match /users/{userId} {
      // Only the owner and moderators can read the private profile. In
      // particular, studentNumber is never exposed to other students.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAccountOwner(userId)
        && !("isAdmin" in request.resource.data)
        && request.resource.data.uid == userId
        && request.resource.data.stuEmail is string
        && request.resource.data.stuEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.studentNumber is string
        && request.resource.data.rating == 0
        && isShortText(request.resource.data.stuName, 120);
      // Owners may edit their profile, but never trust/identity fields.
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.stuEmail == resource.data.stuEmail
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isAdmin', 'rating', 'uid', 'createdAt', 'stuEmail', 'studentNumber'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stuName', 'course', 'year', 'profileImage', 'lastActive', 'updatedAt', 'fcmToken']);
      // Owner can deactivate or soft-delete their own account.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus', 'updatedAt'])
        && request.resource.data.accountStatus in ['deactivated', 'deleted'];
      // Moderators can suspend, restore or delete accounts.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ---- public student directory -----------------------------------------
    // Deliberately excludes studentNumber. Contains only information other
    // students need to find a seller and show a display name.
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isAccountOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.stuEmail is string
        && request.resource.data.stuEmail.lower() == request.auth.token.email.lower()
        && (!("rating" in request.resource.data) || request.resource.data.rating == 0)
        && (!("createdAt" in request.resource.data)
             || request.resource.data.createdAt is timestamp)
        && (!("updatedAt" in request.resource.data)
             || request.resource.data.updatedAt is timestamp)
        && request.resource.data.keys().hasOnly(
             ['uid', 'stuName', 'stuEmail', 'course', 'year', 'rating', 'createdAt', 'updatedAt', 'profileImage', 'lastActive']);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.stuEmail == resource.data.stuEmail
        && (!("rating" in resource.data)
             || (("rating" in request.resource.data)
                 && request.resource.data.rating == resource.data.rating))
        && (!("updatedAt" in request.resource.data)
             || request.resource.data.updatedAt is timestamp)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stuName', 'course', 'year', 'profileImage', 'lastActive', 'updatedAt']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---- marketplace listings ---------------------------------------------
    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sellerID == request.auth.uid
        && !("isAdmin" in request.resource.data)
        && request.resource.data.status == 'AVAILABLE'
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.listingN is string
        && request.resource.data.listingN.size() > 0
        && isShortText(request.resource.data.listingN, 200)
        && isShortText(request.resource.data.description, 5000)
        && isShortText(request.resource.data.get('specs', ''), 2000)
        && isShortText(request.resource.data.category, 80)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.negotiable is bool
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 999
        && request.resource.data.viewCount is number
        && request.resource.data.viewCount >= 0
        && request.resource.data.favouriteCount is number
        && request.resource.data.favouriteCount >= 0
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(
             ['sellerID', 'sellerName', 'listingN', 'description', 'specs', 'price', 'category',
              'condition', 'location', 'delivery', 'status', 'imageURL', 'photos',
              'documentURL', 'documentName', 'documentMime', 'documentSize', 'createdAt',
              'expiresAt', 'negotiable', 'quantity', 'viewCount', 'favouriteCount', 'updatedAt']);
      allow update: if signedIn()
        && resource.data.sellerID == request.auth.uid
        && request.resource.data.sellerID == resource.data.sellerID
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.status in ['AVAILABLE', 'PAUSED', 'SOLD', 'RESERVED', 'ORDERED']
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= 999
        && (request.resource.data.status != 'AVAILABLE' || request.resource.data.quantity > 0)
        && (request.resource.data.status != 'SOLD' || request.resource.data.quantity == 0)
        && (!("expiresAt" in request.resource.data) || request.resource.data.expiresAt is timestamp)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['sellerName', 'listingN', 'description', 'specs', 'price', 'category', 'condition', 'location',
              'delivery', 'status', 'imageURL', 'photos', 'documentURL', 'documentName',
              'documentMime', 'documentSize', 'negotiable', 'quantity', 'viewCount', 'favouriteCount',
              'expiresAt', 'updatedAt']);
      // Any signed-in student can add one view count or one favourite count.
      // The seller update above still covers owner edits.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'updatedAt'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favouriteCount', 'updatedAt'])
        && (request.resource.data.favouriteCount == resource.data.get('favouriteCount', 0) + 1
          || request.resource.data.favouriteCount == resource.data.get('favouriteCount', 0) - 1)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if signedIn()
        && (resource.data.sellerID == request.auth.uid || isAdmin());
    }

    // ---- orders ------------------------------------------------------------
    match /orders/{orderId} {
      function coreFieldsUnchanged() {
        return request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.listingId == resource.data.listingId
          && request.resource.data.price == resource.data.price
          && (!("listPrice" in resource.data)
              || request.resource.data.listPrice == resource.data.listPrice);
      }

      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function cancellationFieldsSet() {
        return request.resource.data.cancellationRequester is string
          && request.resource.data.cancellationReason is string
          && request.resource.data.cancellationReason.size() <= 500
          && request.resource.data.cancellationOutcome is string
          && request.resource.data.cancellationTime is number
          && request.resource.data.cancellationTime > 0;
      }

      function returnFieldsSet() {
        return request.resource.data.returnRequester is string
          && request.resource.data.returnReason is string
          && request.resource.data.returnReason.size() <= 500
          && request.resource.data.returnOutcome is string
          && request.resource.data.returnTime is number
          && request.resource.data.returnTime > 0;
      }

      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin());

      // A purchase starts as a request. The listing must exist, belong to the
      // stated seller, be available, and the price must be derived from that
      // listing. Negotiated offers may be lower than list price but never higher.
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && exists(/databases/$(db)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.sellerID
             == request.resource.data.sellerId
        && get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.status
             == 'AVAILABLE'
        && get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.get('quantity', 1) > 0
        && get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.price
             is number
        && request.resource.data.listPrice is number
        && request.resource.data.listPrice
             == get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.price
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= request.resource.data.listPrice
        && request.resource.data.title is string
        && request.resource.data.title
             == get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.listingN
        && request.resource.data.category is string
        && request.resource.data.category
             == get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.category
        && request.resource.data.buyerEmail is string
        && request.resource.data.buyerEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.sellerEmail is string
        && request.resource.data.sellerEmail.size() <= 200
        && request.resource.data.method is string
        && request.resource.data.method.size() > 0
        && request.resource.data.method.size() <= 80
        && request.resource.data.buyerName is string
        && request.resource.data.buyerName.size() >= 2
        && request.resource.data.buyerName.size() <= 120
        && request.resource.data.buyerPhone is string
        && request.resource.data.buyerPhone.size() >= 7
        && request.resource.data.buyerPhone.size() <= 30
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 300
        && request.resource.data.deliveryMethod in ['Campus pickup', 'Local delivery']
        && request.resource.data.deliveryAddress is string
        && request.resource.data.deliveryAddress.size() <= 300
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(
             ['listingId', 'buyerId', 'sellerId', 'title', 'price', 'listPrice', 'method',
              'buyerEmail', 'sellerEmail', 'buyerName', 'buyerPhone', 'reference',
              'category', 'status', 'deliveryMethod', 'deliveryAddress', 'createdAt']);

      // Explicit transitions only. Cancellation metadata is not free-form:
      //  - REQUESTED -> HELD by seller
      //  - REQUESTED -> CANCELLED by buyer (withdraw) or seller (decline)
      //  - HELD -> COMPLETED by buyer, only when no cancellation is pending
      //  - HELD -> HELD for request/withdraw/decline cancellation
      //  - HELD -> CANCELLED for the other participant's approval
      //  - COMPLETED -> COMPLETED for a seller payout request
      allow update: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid)
        && coreFieldsUnchanged()
        && request.resource.data.updatedAt is timestamp
        && (
          // Seller accepts the purchase request.
          (resource.data.status == 'REQUESTED'
            && request.resource.data.status == 'HELD'
            && request.auth.uid == resource.data.sellerId
            && changedOnly(['status', 'updatedAt']))
          ||
          // Buyer withdraws, or seller declines, a pending request.
          (resource.data.status == 'REQUESTED'
            && request.resource.data.status == 'CANCELLED'
            && cancellationFieldsSet()
            && request.resource.data.cancellationRequester == ''
            && changedOnly(['status', 'cancellationRequester', 'cancellationReason',
                            'cancellationOutcome', 'cancellationTime', 'updatedAt'])
            && (
              (request.auth.uid == resource.data.buyerId
                && request.resource.data.cancellationOutcome == 'Withdrawn by buyer')
              || (request.auth.uid == resource.data.sellerId
                && request.resource.data.cancellationOutcome in
                   ['Declined by seller', 'Another request was accepted'])
            ))
          ||
          // Buyer photographs the received item. This never completes the
          // order; the seller must review and verify it first.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'HELD'
            && request.auth.uid == resource.data.buyerId
            && resource.data.get('cancellationRequester', '') == ''
            && request.resource.data.collectionPhotoUrl is string
            && request.resource.data.collectionPhotoUrl.size() > 0
            && request.resource.data.collectionPhotoUrl.size() <= 1000
            && request.resource.data.collectionPhotoBy is string
            && request.resource.data.collectionPhotoBy.lower() == request.auth.token.email.lower()
            && request.resource.data.collectionPhotoTime is number
            && request.resource.data.collectionPhotoTime > 0
            && request.resource.data.get('sellerVerifiedTime', 0) == 0
            && changedOnly(['status', 'collectionPhotoUrl', 'collectionPhotoBy',
                            'collectionPhotoTime', 'buyerLat', 'buyerLng',
                            'buyerLocationAt', 'updatedAt']))
          ||
          // Buyer live-location feed for a delivery order.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'HELD'
            && request.auth.uid == resource.data.buyerId
            && resource.data.get('cancellationRequester', '') == ''
            && request.resource.data.buyerLat is number
            && request.resource.data.buyerLat >= -90
            && request.resource.data.buyerLat <= 90
            && request.resource.data.buyerLng is number
            && request.resource.data.buyerLng >= -180
            && request.resource.data.buyerLng <= 180
            && request.resource.data.buyerLocationAt is number
            && request.resource.data.buyerLocationAt > 0
            && changedOnly(['status', 'buyerLat', 'buyerLng', 'buyerLocationAt', 'updatedAt']))
          ||
          // Seller live-location feed for a delivery order.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'HELD'
            && request.auth.uid == resource.data.sellerId
            && resource.data.get('cancellationRequester', '') == ''
            && request.resource.data.sellerLat is number
            && request.resource.data.sellerLat >= -90
            && request.resource.data.sellerLat <= 90
            && request.resource.data.sellerLng is number
            && request.resource.data.sellerLng >= -180
            && request.resource.data.sellerLng <= 180
            && request.resource.data.sellerLocationAt is number
            && request.resource.data.sellerLocationAt > 0
            && changedOnly(['status', 'sellerLat', 'sellerLng', 'sellerLocationAt', 'updatedAt']))
          ||
          // Seller verifies the buyer's collection photo and completes the
          // sale. Buyers can never complete an order by tapping a button.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'COMPLETED'
            && request.auth.uid == resource.data.sellerId
            && resource.data.get('cancellationRequester', '') == ''
            && resource.data.get('collectionPhotoUrl', '') != ''
            && resource.data.get('collectionPhotoBy', '') == resource.data.buyerEmail
            && request.resource.data.get('collectionPhotoUrl', '') == resource.data.get('collectionPhotoUrl', '')
            && request.resource.data.get('collectionPhotoBy', '') == resource.data.get('collectionPhotoBy', '')
            && request.resource.data.sellerVerifiedBy is string
            && request.resource.data.sellerVerifiedBy.lower() == request.auth.token.email.lower()
            && request.resource.data.sellerVerifiedTime is number
            && request.resource.data.sellerVerifiedTime > 0
            && request.resource.data.invoiceNumber is string
            && request.resource.data.invoiceNumber.size() > 0
            && request.resource.data.invoiceNumber.size() <= 80
            && request.resource.data.invoiceFinalizedAt is number
            && request.resource.data.invoiceFinalizedAt > 0
            && changedOnly(['status', 'sellerVerifiedBy', 'sellerVerifiedTime',
                            'invoiceNumber', 'invoiceFinalizedAt', 'sellerLat',
                            'sellerLng', 'sellerLocationAt', 'updatedAt']))
          ||
          // Either participant asks the other to cancel a held order.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'HELD'
            && resource.data.get('cancellationRequester', '') == ''
            && cancellationFieldsSet()
            && request.resource.data.cancellationRequester == request.auth.token.email.lower()
            && request.resource.data.cancellationReason.size() > 0
            && request.resource.data.cancellationOutcome == 'Requested'
            && changedOnly(['status', 'cancellationRequester', 'cancellationReason',
                            'cancellationOutcome', 'cancellationTime', 'updatedAt']))
          ||
          // The requester withdraws their own cancellation request.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'HELD'
            && resource.data.get('cancellationRequester', '') == request.auth.token.email.lower()
            && cancellationFieldsSet()
            && request.resource.data.cancellationRequester == ''
            && request.resource.data.cancellationOutcome == 'Withdrawn'
            && changedOnly(['status', 'cancellationRequester', 'cancellationReason',
                            'cancellationOutcome', 'cancellationTime', 'updatedAt']))
          ||
          // The other participant declines a cancellation request.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'HELD'
            && resource.data.get('cancellationRequester', '') != ''
            && resource.data.get('cancellationRequester', '') != request.auth.token.email.lower()
            && cancellationFieldsSet()
            && request.resource.data.cancellationRequester == ''
            && request.resource.data.cancellationOutcome == 'Declined'
            && changedOnly(['status', 'cancellationRequester', 'cancellationReason',
                            'cancellationOutcome', 'cancellationTime', 'updatedAt']))
          ||
          // The other participant approves the cancellation.
          (resource.data.status == 'HELD'
            && request.resource.data.status == 'CANCELLED'
            && resource.data.get('cancellationRequester', '') != ''
            && resource.data.get('cancellationRequester', '') != request.auth.token.email.lower()
            && cancellationFieldsSet()
            && request.resource.data.cancellationRequester == ''
            && request.resource.data.cancellationOutcome == 'Approved'
            && changedOnly(['status', 'cancellationRequester', 'cancellationReason',
                            'cancellationOutcome', 'cancellationTime', 'updatedAt']))
          ||
          // Buyer requests a return after collection. The sale remains COMPLETED.
          (resource.data.status == 'COMPLETED'
            && request.resource.data.status == 'COMPLETED'
            && request.auth.uid == resource.data.buyerId
            && resource.data.get('returnOutcome', '') == ''
            && returnFieldsSet()
            && request.resource.data.returnRequester == request.auth.token.email.lower()
            && request.resource.data.returnOutcome == 'Requested'
            && changedOnly(['status', 'returnRequester', 'returnReason',
                            'returnOutcome', 'returnTime', 'updatedAt']))
          ||
          // Seller approves or declines the return request.
          (resource.data.status == 'COMPLETED'
            && request.resource.data.status == 'COMPLETED'
            && request.auth.uid == resource.data.sellerId
            && resource.data.get('returnOutcome', '') == 'Requested'
            && resource.data.get('returnRequester', '') != ''
            && returnFieldsSet()
            && request.resource.data.returnRequester == ''
            && request.resource.data.returnOutcome in ['Approved', 'Declined']
            && changedOnly(['status', 'returnRequester', 'returnReason',
                            'returnOutcome', 'returnTime', 'updatedAt']))
          ||
          // Buyer withdraws their own return request.
          (resource.data.status == 'COMPLETED'
            && request.resource.data.status == 'COMPLETED'
            && request.auth.uid == resource.data.buyerId
            && resource.data.get('returnOutcome', '') == 'Requested'
            && resource.data.get('returnRequester', '') == request.auth.token.email.lower()
            && returnFieldsSet()
            && request.resource.data.returnRequester == ''
            && request.resource.data.returnOutcome == 'Withdrawn'
            && changedOnly(['status', 'returnRequester', 'returnReason',
                            'returnOutcome', 'returnTime', 'updatedAt']))
          ||
          // Seller records a future payout preference for a completed sale.
          (resource.data.status == 'COMPLETED'
            && request.resource.data.status == 'COMPLETED'
            && request.auth.uid == resource.data.sellerId
            && resource.data.get('payoutRequestedAt', 0) == 0
            && resource.data.method != 'Cash on collection'
            && resource.data.method != 'Free collection'
            && resource.data.price > 0
            && request.resource.data.payoutRequestedAt is number
            && request.resource.data.payoutRequestedAt > 0
            && request.resource.data.payoutMethod in ['Bank transfer', 'Payment-provider balance']
            && request.resource.data.payoutSchedule in ['After collection', 'Weekly', 'On request']
            && changedOnly(['payoutRequestedAt', 'payoutMethod', 'payoutSchedule', 'updatedAt']))
          ||
          // Either participant clears stored live positions once the handover
          // is finished or the order is cancelled. This only removes data.
          ((resource.data.status == 'COMPLETED' || resource.data.status == 'CANCELLED')
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('buyerLat', 0) == 0
            && request.resource.data.get('buyerLng', 0) == 0
            && request.resource.data.get('buyerLocationAt', 0) == 0
            && request.resource.data.get('sellerLat', 0) == 0
            && request.resource.data.get('sellerLng', 0) == 0
            && request.resource.data.get('sellerLocationAt', 0) == 0
            && changedOnly(['buyerLat', 'buyerLng', 'buyerLocationAt',
                            'sellerLat', 'sellerLng', 'sellerLocationAt', 'updatedAt']))
        );
      allow delete: if false;
    }

    // ---- chats -------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if signedIn()
        && (resource.data.buyerID == request.auth.uid
          || resource.data.sellerID == request.auth.uid);

      // The buyer opens one chat per listing/seller, or one "direct" chat.
      // Deterministic ids make duplicate creation idempotent in the client.
      allow create: if signedIn()
        && request.resource.data.buyerID == request.auth.uid
        && request.resource.data.sellerID is string
        && request.resource.data.sellerID != request.auth.uid
        && request.resource.data.listingID is string
        && request.resource.data.createdDate is timestamp
        && request.resource.data.keys().hasOnly(['buyerID', 'sellerID', 'listingID', 'createdDate'])
        && chatId == chatDocId(request.resource.data.buyerID,
                               request.resource.data.sellerID,
                               request.resource.data.listingID)
        && (
          (request.resource.data.listingID == 'direct'
            && exists(/databases/$(db)/documents/publicProfiles/$(request.resource.data.sellerID)))
          ||
          (request.resource.data.listingID != 'direct'
            && exists(/databases/$(db)/documents/listings/$(request.resource.data.listingID))
            && get(/databases/$(db)/documents/listings/$(request.resource.data.listingID)).data.sellerID
                 == request.resource.data.sellerID)
        );
      // Each student may only update the short typing hint in the chat header.
      allow update: if signedIn()
        && (resource.data.buyerID == request.auth.uid
          || resource.data.sellerID == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['typingUid', 'typingAt'])
        && request.resource.data.typingUid == request.auth.uid
        && request.resource.data.typingAt is timestamp;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && (get(/databases/$(db)/documents/chats/$(chatId)).data.buyerID == request.auth.uid
            || get(/databases/$(db)/documents/chats/$(chatId)).data.sellerID == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.senderID == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.timestamp is timestamp
          && request.resource.data.keys().hasOnly(['senderID', 'message', 'timestamp'])
          && (get(/databases/$(db)/documents/chats/$(chatId)).data.buyerID == request.auth.uid
            || get(/databases/$(db)/documents/chats/$(chatId)).data.sellerID == request.auth.uid);
        // The recipient marks messages as read; nobody can edit the text or sender.
        allow update: if signedIn()
          && request.auth.uid != resource.data.senderID
          && request.resource.data.readAt is timestamp
          && request.resource.data.senderID == resource.data.senderID
          && request.resource.data.message == resource.data.message
          && request.resource.data.timestamp == resource.data.timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && (get(/databases/$(db)/documents/chats/$(chatId)).data.buyerID == request.auth.uid
            || get(/databases/$(db)/documents/chats/$(chatId)).data.sellerID == request.auth.uid);
        allow delete: if false;
      }
    }

    // ---- ratings -----------------------------------------------------------
    // Document id is "<orderId>_<reviewerUid>" (one review per student per
    // order). The order must be COMPLETED before either participant can rate.
    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reviewerID == request.auth.uid
        && request.resource.data.reviewedUserID is string
        && request.resource.data.reviewedUserID != request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isShortText(request.resource.data.comment, 1000)
        && request.resource.data.orderId is string
        && request.resource.data.createdAt is timestamp
        && ratingId == request.resource.data.orderId + '_' + request.auth.uid
        && exists(/databases/$(db)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.status
             == 'COMPLETED'
        && (
          (get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.buyerId == request.auth.uid
            && get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.sellerId
               == request.resource.data.reviewedUserID)
          || (get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.sellerId == request.auth.uid
            && get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.buyerId
               == request.resource.data.reviewedUserID)
        );
      // Moderators can remove a review after it is reported.
      allow update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userID == request.auth.uid
        && isShortText(request.resource.data.description, 2000);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /academicContent/{contentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uploaderID == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.uploaderID == request.auth.uid;
    }

    // ---- study groups ------------------------------------------------------
    match /studyGroups/{groupId} {
      // Group name, module and description are discoverable so students can
      // search for both public and private groups. The feed remains members-only.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorID == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.creatorID == resource.data.creatorID
        && (
          resource.data.creatorID == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
              && request.resource.data.members.toSet().difference(resource.data.members.toSet())
                   .hasOnly([request.auth.uid])
              && resource.data.members.toSet().difference(request.resource.data.members.toSet())
                   .hasOnly([request.auth.uid])
              && (request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
                  || resource.data.get('private', false) == false))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests'])
              && request.resource.data.requests.toSet()
                   .difference(resource.data.get('requests', []).toSet())
                   .hasOnly([request.auth.uid])
              && resource.data.get('requests', []).toSet()
                   .difference(request.resource.data.requests.toSet()).size() == 0)
        );
      allow delete: if signedIn()
        && resource.data.creatorID == request.auth.uid;

      match /posts/{postId} {
        // Group content is members-only.
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(db)/documents/studyGroups/$(groupId)).data.get('members', []);
        allow create: if signedIn()
          && request.resource.data.authorID == request.auth.uid
          && request.auth.uid in get(/databases/$(db)/documents/studyGroups/$(groupId)).data.get('members', []);
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(db)/documents/studyGroups/$(groupId)).data.get('members', [])
          && request.resource.data.authorID == resource.data.authorID
          && (resource.data.authorID == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
        allow delete: if signedIn()
          && resource.data.authorID == request.auth.uid;
      }
    }

    // ---- optional sync targets: the app still stores these locally. --------
    match /offers/{offerId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.state == 'Pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 9999999.99
        && request.resource.data.turn is string
        && request.resource.data.turn.lower()
             == get(/databases/$(db)/documents/users/$(request.resource.data.sellerId)).data.stuEmail.lower()
        && request.resource.data.created is number
        && request.resource.data.created > 0
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt >= 0
        && exists(/databases/$(db)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.sellerID
             == request.resource.data.sellerId
        && get(/databases/$(db)/documents/listings/$(request.resource.data.listingId)).data.get('quantity', 1) > 0
        && request.resource.data.get('buyerEmail', request.auth.token.email).lower()
             == request.auth.token.email.lower()
        && request.resource.data.get('sellerEmail',
             get(/databases/$(db)/documents/users/$(request.resource.data.sellerId)).data.stuEmail).lower()
             == get(/databases/$(db)/documents/users/$(request.resource.data.sellerId)).data.stuEmail.lower()
        && request.resource.data.keys().hasOnly(
             ['buyerId', 'sellerId', 'listingId', 'buyerEmail', 'sellerEmail',
              'amount', 'turn', 'state', 'created', 'expiresAt']);
      // Offers are a turn-based state machine. Only the student whose turn it is
      // can accept, decline or counter; either participant can cancel; only the
      // seller can close offers when the listing closes.
      allow update: if signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.created == resource.data.created
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 9999999.99
        && request.resource.data.turn is string
        && request.resource.data.state in
             ['Pending', 'Countered', 'Accepted', 'Declined', 'Cancelled', 'Closed']
        && request.resource.data.expiresAt is number
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'turn', 'state', 'expiresAt'])
        && (
          (resource.data.state in ['Pending', 'Countered']
            && resource.data.turn.lower() == request.auth.token.email.lower()
            && request.resource.data.state == 'Accepted'
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.turn == resource.data.turn
            && request.resource.data.expiresAt > resource.data.expiresAt)
          ||
          (resource.data.state in ['Pending', 'Countered']
            && resource.data.turn.lower() == request.auth.token.email.lower()
            && request.resource.data.state == 'Declined'
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.turn == resource.data.turn
            && request.resource.data.expiresAt == resource.data.expiresAt)
          ||
          (resource.data.state in ['Pending', 'Countered']
            && resource.data.turn.lower() == request.auth.token.email.lower()
            && request.resource.data.state == 'Countered'
            && request.resource.data.expiresAt == resource.data.expiresAt
            && (
              (request.auth.uid == resource.data.buyerId
                && request.resource.data.turn.lower()
                     == get(/databases/$(db)/documents/users/$(resource.data.sellerId)).data.stuEmail.lower())
              ||
              (request.auth.uid == resource.data.sellerId
                && request.resource.data.turn.lower()
                     == get(/databases/$(db)/documents/users/$(resource.data.buyerId)).data.stuEmail.lower())
            ))
          ||
          (resource.data.state in ['Pending', 'Countered', 'Accepted']
            && request.resource.data.state == 'Cancelled'
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.turn == resource.data.turn
            && request.resource.data.expiresAt == resource.data.expiresAt)
          ||
          (resource.data.sellerId == request.auth.uid
            && resource.data.state in ['Pending', 'Countered', 'Accepted']
            && request.resource.data.state == 'Closed'
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.turn == resource.data.turn
            && request.resource.data.expiresAt == resource.data.expiresAt)
        );
      allow delete: if false;
    }

    // ---- pickup plans ------------------------------------------------------
    match /pickups/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid);
      allow create: if signedIn()
        && exists(/databases/$(db)/documents/orders/$(orderId))
        && get(/databases/$(db)/documents/orders/$(orderId)).data.buyerId
             == request.resource.data.buyerId
        && get(/databases/$(db)/documents/orders/$(orderId)).data.sellerId
             == request.resource.data.sellerId
        && (request.resource.data.buyerId == request.auth.uid
          || request.resource.data.sellerId == request.auth.uid)
        && request.resource.data.orderId == orderId
        && request.resource.data.buyerEmail is string
        && request.resource.data.sellerEmail is string
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 3
        && request.resource.data.location.size() <= 200
        && request.resource.data.time is number
        && request.resource.data.time > 0
        && request.resource.data.confirmed is list
        && request.resource.data.confirmed.toSet().hasOnly([request.auth.token.email.lower()])
        && request.resource.data.revision is number
        && request.resource.data.revision >= 1
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.lower() == request.auth.token.email.lower()
        && request.resource.data.arrangementUpdatedAt is number
        && request.resource.data.arrangementUpdatedAt > 0
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(
             ['orderId', 'buyerId', 'sellerId', 'buyerEmail', 'sellerEmail', 'location',
              'time', 'confirmed', 'revision', 'updatedBy', 'arrangementUpdatedAt', 'updatedAt']);
      // A confirmation keeps the place/time and revision. Any new arrangement
      // must increment the revision and reset confirmations to the proposer.
      allow update: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid)
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.buyerEmail == resource.data.buyerEmail
        && request.resource.data.sellerEmail == resource.data.sellerEmail
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 3
        && request.resource.data.location.size() <= 200
        && request.resource.data.time is number
        && request.resource.data.time > 0
        && request.resource.data.confirmed is list
        && request.resource.data.confirmed.toSet().hasOnly(
             [resource.data.buyerEmail.lower(), resource.data.sellerEmail.lower()])
        && request.resource.data.revision is number
        && request.resource.data.revision >= 1
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy.lower() == request.auth.token.email.lower()
        && request.resource.data.arrangementUpdatedAt is number
        && request.resource.data.arrangementUpdatedAt > 0
        && (
          (request.resource.data.location == resource.data.location
            && request.resource.data.time == resource.data.time
            && request.resource.data.revision == resource.data.get('revision', 1)
            && request.resource.data.confirmed.toSet()
                 .difference(resource.data.confirmed.toSet())
                 .hasOnly([request.auth.token.email.lower()])
            && resource.data.confirmed.toSet()
                 .difference(request.resource.data.confirmed.toSet()).size() == 0
            && request.resource.data.arrangementUpdatedAt
                 >= resource.data.arrangementUpdatedAt)
          ||
          (request.resource.data.revision == resource.data.get('revision', 1) + 1
            && request.resource.data.confirmed.toSet()
                 .hasOnly([request.auth.token.email.lower()])
            && request.resource.data.arrangementUpdatedAt
                 > resource.data.arrangementUpdatedAt)
        )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['location', 'time', 'confirmed', 'revision', 'updatedBy',
                       'arrangementUpdatedAt', 'updatedAt']);
      allow delete: if false;
    }

    match /wanted/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /searchAlerts/{alertId} {
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.state == 'Open';
      // A reporter can see their own report and rate the outcome. Moderation
      // fields remain admin-only.
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.reporterId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['satisfaction', 'satisfactionComment', 'satisfactionAt', 'satisfactionBy'])
            && request.resource.data.satisfaction is number
            && request.resource.data.satisfaction >= 1
            && request.resource.data.satisfaction <= 5
            && request.resource.data.satisfactionBy.lower() == request.auth.token.email.lower());
      allow delete: if isAdmin();
    }

    // ---- moderator listing tombstones -------------------------------------
    match /deletedListings/{listingId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.listingId == listingId
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 8
        && request.resource.data.removedBy is string
        && request.resource.data.deletedAt is timestamp;
      allow update, delete: if false;
    }

    // ---- suspensions and content-warning appeals --------------------------
    match /appeals/{appealId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 20
        && request.resource.data.reason.size() <= 1200
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---- content safety ----------------------------------------------------
    match /contentFlags/{flagId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.strike is number
        && request.resource.data.strike >= 1
        && request.resource.data.strike <= 3
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /contentSanctions/{userId} {
      // Moderators issue and clear sanctions. Students can read their own
      // standing so a cleared appeal reaches every device.
      allow read: if isAdmin() || isOwner(userId);
      allow create, update, delete: if isAdmin();
    }

    // ---- favourites --------------------------------------------------------
    match /favourites/{favouriteId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.createdAt is timestamp
        && favouriteId == request.auth.uid + '_' + request.resource.data.listingId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ---- administrator audit trail ----------------------------------------
    match /admin_actions/{actionId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ---- blocked users -----------------------------------------------------
    match /blockedUsers/{blockId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.blockedUserId is string;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }
  }
}
